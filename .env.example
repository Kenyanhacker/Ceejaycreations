# Google Analytics 4 measurement ID (Settings > Data Streams in GA4)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Google Search Console verification token (optional). Replace with the token provided by Google Search Console
VITE_GSC_TOKEN=REPLACE_WITH_YOUR_GSC_TOKEN
# Contact email used in site footer and contact links. Override with Vite env in production.
VITE_CONTACT_EMAIL=ceejaycreationofficial@gmail.com
